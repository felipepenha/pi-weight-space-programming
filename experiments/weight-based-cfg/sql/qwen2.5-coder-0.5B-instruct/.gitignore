.pi/git/
.pi/cache/

# Hugging Face models cache
.cache/huggingface/

# Model inputs/outputs
models/

# Virtual environment & Python cache
.venv/
__pycache__/
*.py[cod]

# WSP session artifacts & logs
.wsp-work/
logs/

# Evaluation dataset/DB download cache (re-fetched on demand)
eval/.cache/

# Track session transcript and evaluation summaries for review
!session.log
!eval/runs/**/run.log
!eval/runs/**/summary.json

# Verbose per-question prediction & mismatch dumps (keep summaries & run logs)
eval/runs/**/predictions_*.jsonl
eval/runs/**/llmsql_report_*.json

# Lock files are not to be ignored (tracked in version control)
!*.lock
!uv.lock

# Hugging Face models cache & local weights
.cache/
